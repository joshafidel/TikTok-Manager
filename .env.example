# Required: your Anthropic API key (console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Local SQLite file by default. To run this on your phone, point it at a
# Turso database instead (https://turso.tech) and set the auth token:
#   DATABASE_URL=libsql://your-db.turso.io
#   DATABASE_AUTH_TOKEN=...
DATABASE_URL=file:./data/app.db
# DATABASE_AUTH_TOKEN=
