# ---------------------------------------------------------------------------
# Required everywhere
# ---------------------------------------------------------------------------

# Your Anthropic API key — console.anthropic.com → API keys
ANTHROPIC_API_KEY=sk-ant-...

# ---------------------------------------------------------------------------
# Required in production (any deployed instance)
# ---------------------------------------------------------------------------

# Password for the sign-in gate. Without it a deployed instance refuses to
# serve, because an open URL would expose your content and your API key.
# Leave it unset locally to skip the login screen on your laptop.
# APP_PASSWORD=

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# Local: a SQLite file. This is the default and needs nothing else.
DATABASE_URL=file:./data/app.db

# Deployed: Vercel's filesystem is ephemeral, so a file won't survive.
# Point at a Turso database instead and add the token:
#   DATABASE_URL=libsql://your-db-name-you.turso.io
#   DATABASE_AUTH_TOKEN=eyJ...
# DATABASE_AUTH_TOKEN=

# ---------------------------------------------------------------------------
# Video auto-editing (optional — the rest of the app works without these)
# ---------------------------------------------------------------------------

# Vercel Blob, for the uploaded recordings. Adding Blob storage to your Vercel
# project sets this automatically; you only need it for local uploads.
# BLOB_READ_WRITE_TOKEN=

# AssemblyAI — transcribes your recording with word-level timings so the
# editor knows where the filler words and dead air are. assemblyai.com
# ASSEMBLYAI_API_KEY=

# Shotstack — renders the finished vertical MP4 with burned-in captions.
# Leave SHOTSTACK_ENV unset to use the free sandbox (adds a watermark);
# set it to "production" once you're happy with the results. shotstack.io
# SHOTSTACK_API_KEY=
# SHOTSTACK_ENV=production
