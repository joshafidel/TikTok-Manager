# ---------------------------------------------------------------------------
# Required everywhere
# ---------------------------------------------------------------------------

# Your Anthropic API key — console.anthropic.com → API keys
ANTHROPIC_API_KEY=sk-ant-...

# ---------------------------------------------------------------------------
# Required in production (any deployed instance)
# ---------------------------------------------------------------------------

# Password for the sign-in gate. Without it a deployed instance refuses to
# serve, because an open URL would expose your content and your API key.
# Leave it unset locally to skip the login screen on your laptop.
# APP_PASSWORD=

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# Local: a SQLite file. This is the default and needs nothing else.
DATABASE_URL=file:./data/app.db

# Deployed: Vercel's filesystem is ephemeral, so a file won't survive.
# Point at a Turso database instead and add the token:
#   DATABASE_URL=libsql://your-db-name-you.turso.io
#   DATABASE_AUTH_TOKEN=eyJ...
# DATABASE_AUTH_TOKEN=
